{
  "expo": {
    "name": "Sonora",
    "slug": "sonora",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sonora",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.venkatesh.sonora",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "background"
        ],
        "ITSAppUsesNonExemptEncryptionData": false
      }
    },
    "android": {
      "package": "com.venkatesh.sonora",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0E0E12"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
